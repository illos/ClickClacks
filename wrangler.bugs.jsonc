{
  "name": "clickclacks-app",
  "main": "worker/index.ts",
  "account_id": "462b5ee1e395c11b8523d6c38de0577a",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "dice.clickclacks.app", "custom_domain": true },
    { "pattern": "app.clickclacks.app", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index.html", "/web/popout/tray.html", "/pip/web/popout/tray.html"],
    "html_handling": "none",
    "not_found_handling": "404-page",
  },
  "d1_databases": [
    {"binding": "METRICS", "database_name": "clickclacks-bug-reports", "database_id": "9eddbb4b-5dbd-4093-99c3-c533605fab18", "migrations_dir": "worker/migrations"},
    {
      "binding": "BUG_REPORTS",
      "database_name": "clickclacks-bug-reports",
      "database_id": "9eddbb4b-5dbd-4093-99c3-c533605fab18",
      "migrations_dir": "worker/migrations",
    },
  ],
  "ratelimits": [
    {"name": "METRICS_LIMITER", "namespace_id": "1002", "simple": {"limit": 100, "period": 60}},
    {
      "name": "BUG_REPORT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "triggers": { "crons": ["17 3 * * *"] },
}

{
  "name": "clickclacks-landing",
  "main": "worker/landing.ts",
  "account_id": "462b5ee1e395c11b8523d6c38de0577a",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "clickclacks.app", "custom_domain": true }],
  "assets": {
    "directory": "./dist/landing-demo",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/landing.html", "/web/landing/mini.html"],
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
